{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strictPropertyInitialization": false,
    "noEmit": false,
    "outDir": "./dist",
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
