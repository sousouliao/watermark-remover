# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for shell scripts (critical for cross-platform husky support)
*.sh text eol=lf

# Husky hooks must use LF line endings on all platforms
.husky/** text eol=lf

# Windows specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Keep binary files as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
